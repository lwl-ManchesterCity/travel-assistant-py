# 复制为 .env 后填值；.env 只放本机，不要提交、不要写进代码或 README。
# 变量名与 `settings.py` 里各字段的 validation_alias 一一对应。

# Loop 多轮闭环，默认值与 `settings.py` 一致
TRAVEL_LOOP_ENABLED=true
TRAVEL_LOOP_MAX_ROUNDS=3
TRAVEL_LOOP_MAX_NO_IMPROVEMENT_ROUNDS=2

# 本版本取数链路依赖模型，必须开启并给出可用 key
TRAVEL_LLM_ENABLED=true
TRAVEL_LLM_PROVIDER=dashscope
TRAVEL_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
TRAVEL_LLM_API_KEY=
TRAVEL_LLM_MODEL=qwen-plus
TRAVEL_LLM_TEMPERATURE=0.2

# 也可以只导出 DASHSCOPE_API_KEY（`TRAVEL_LLM_API_KEY` 为空时回退读它）

# 高德四个数据源：amap 走真实接口，其他值走规则/本地兜底实现
TRAVEL_PROVIDERS_ATTRACTION=amap
TRAVEL_PROVIDERS_WEATHER=amap
TRAVEL_PROVIDERS_HOTEL=amap
TRAVEL_PROVIDERS_ROUTE=amap

AMAP_API_KEY=
AMAP_BASE_URL=http://restapi.amap.com
AMAP_MOCK_RESPONSE=false
AMAP_ROUTE_STRATEGY=0
AMAP_ROUTE_EXTENSIONS=base
AMAP_CURL_FALLBACK_ENABLED=true
AMAP_POI_PAGE_SIZE=10
AMAP_CITY_LIMIT=true
AMAP_WEB_JS_KEY=
AMAP_SECURITY_JS_CODE=

SERVER_PORT=8080
